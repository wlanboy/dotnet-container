<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Muss zur .NET-Version der Docker-Images (sdk:10.0-aot / runtime-deps:10.0) passen -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Native AOT erzeugt plattformspezifische Binaries statt portablem IL -> jede Zielplattform muss hier stehen; Docker-Build nutzt konkret linux-x64 -->
    <!-- win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64 -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!-- Best Practice: fängt NullReferenceExceptions schon zur Compile-Zeit ab -->
    <Nullable>enable</Nullable>
    <!-- Reduziert Boilerplate-usings, rein stilistisch -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Verzicht auf ICU/Kultur-Daten -> kleineres AOT-Binary und erlaubt Runtime-Image ohne libicu -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Bündelt die .NET-Runtime im Output -> Runtime-Image braucht kein dotnet/aspnet-Image, nur OS-Libs -->
    <SelfContained>true</SelfContained>
    <!-- Erzwingt Self-Contained explizit auch für den publish-Task (wird nicht immer automatisch übernommen) -->
    <PublishSelfContained>true</PublishSelfContained>

    <!-- Kernschalter: nativer Maschinencode statt IL+JIT -> schnellerer Kaltstart, weniger Speicher, kein Runtime-Overhead im Container -->
    <PublishAot>true</PublishAot>

    <!-- Deaktiviert die EventSource/EventListener-Infrastruktur (ETW/EventPipe-Traces) ->
         wird durch DOTNET_EnableDiagnostics=0 im Container ohnehin nicht genutzt, der
         Trimmer kann den zugehörigen Code dadurch zusätzlich aus dem AOT-Binary entfernen -->
    <EventSourceSupport>false</EventSourceSupport>
    <!-- Deaktiviert die automatische Activity-Propagation von DiagnosticSource/HttpClient
         (Grundlage für Distributed Tracing) -> ohne Tracing-Backend hier ungenutzter Code,
         spart Overhead pro Request und Binary-Größe -->
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>

    <!-- Native AOT legt die Debug-Symbole als separate dotnetrest.dbg (~25 MB) neben das Binary.
         Nicht in den Publish-Ordner (und damit nicht ins Image) kopieren; die Datei bleibt
         unter bin/ bzw. obj/ erhalten, falls Symbole für Crash-Analysen gebraucht werden -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dev-Config gehört nicht ins Production-Image -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- CreateSlimBuilder (Program.cs) enthält OpenAPI-Support nicht standardmäßig -> für MapOpenApi manuell nachgezogen.
         Bewusst auch im Production-Binary, der Endpunkt wird nur in Development gemappt (siehe readme.md, Abschnitt OpenAPI). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

</Project>
